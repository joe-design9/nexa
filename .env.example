# ─── Nexa – Umgebungsvariablen (Beispiel) ────────────────────────────────
# Kopiere diese Datei nach ".env" und passe die Werte an.
# Niemals echte Geheimnisse committen.

# ── Allgemein ────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── Datenbank (PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=postgresql://nexa:nexa_dev_password@localhost:5432/nexa?schema=public

# ── Redis (Presence, Socket.IO-Adapter, Cache) ───────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ───────────────────────────────────────────────────────────
# Lange, zufällige Strings verwenden (z. B. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ── E-Mail (SMTP) ────────────────────────────────────────────────────────
# Ohne SMTP-Konfiguration werden Verifizierungs-/Reset-Links ins
# Server-Log geschrieben (Dev-Modus). In Docker zeigt SMTP_HOST auf MailHog.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nexa <no-reply@nexa.local>"

# ── Captcha (hCaptcha oder Cloudflare Turnstile) ─────────────────────────
# Leer lassen + CAPTCHA_DEV_BYPASS=true für lokale Entwicklung ohne Anbieter.
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_DEV_BYPASS=true

# ── Dateien (S3-kompatibel, lokal MinIO) ─────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexa-uploads
S3_ACCESS_KEY=nexa_minio
S3_SECRET_KEY=nexa_minio_password
S3_PUBLIC_URL=http://localhost:9000/nexa-uploads
MAX_UPLOAD_MB=25

# ── LiveKit (Sprache/Video) ──────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_32_chars_minimum

# ── Social Login (OAuth 2.0 / OIDC) ──────────────────────────────────────
# Ohne diese Werte sind die Buttons "Mit Google/Apple anmelden" zwar
# sichtbar, der Flow leitet aber mit einem Fehler auf die Login-Seite
# zurück (kein Fake-Login). Einrichtung: siehe README, Abschnitt "Social Login".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/oauth/google/callback

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Inhalt des .p8-Schlüssels (Zeilenumbrüche als \n) ODER Pfad zur Datei:
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=
APPLE_CALLBACK_URL=http://localhost:4000/auth/oauth/apple/callback

# ── Rate-Limits ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
